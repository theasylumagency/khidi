# PostgreSQL 18 Role Provisioning & Connection URLs ([C7] role separation)
HUB_MIGRATOR_DB_USER=hub_migrator
HUB_MIGRATOR_DB_PASSWORD=hub_migrator_dev_password
HUB_APP_DB_PASSWORD=hub_app_dev_password
HUB_DB_NAME=agrotrade_hub_dev
DATABASE_MIGRATOR_URL=postgres://hub_migrator:hub_migrator_dev_password@127.0.0.1:5435/agrotrade_hub_dev
DATABASE_URL=postgres://hub_app:hub_app_dev_password@127.0.0.1:5435/agrotrade_hub_dev

# Khidi Hub Concealment & Auth Secrets (§4.3, §16.2, §16.3)
HUB_NEUTRAL_DOMAIN=khidi.internal.local
HUB_SESSION_SECRET=dev-only-session-secret-32-bytes-minimum-khidi-hub
HUB_TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Office passkeys: exact host/origin; use localhost for local WebAuthn testing.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3100
AUTH_RECENT_WINDOW_SECONDS=600

# Web Push VAPID Keys (§14, [C6])
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=UUxI4O8-FbRouAevSmBQ6o18hgE4nSG3qwvJTfKc-ls
VAPID_SUBJECT=mailto:ops@khidi.internal.local

# M4 media. Filesystem is development-only; Hub and worker share this repository-relative root.
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_FILESYSTEM_ROOT=.local-media
MEDIA_SIGNING_SECRET=khidi_media_signing_development_secret_only
# To use local MinIO: start the media compose profile, initialize it, then select s3.
MEDIA_PRIVATE_BUCKET=khidi-private
MEDIA_PUBLIC_BUCKET=khidi-public
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY_ID=khidi-runtime
MEDIA_S3_SECRET_ACCESS_KEY=khidi_runtime_dev_password
MINIO_DEV_ROOT_USER=khidi-dev
MINIO_DEV_ROOT_PASSWORD=khidi_minio_dev_password
# Production: use HTTPS/S3, separate protected buckets, a restricted IAM role/account,
# and a new random signing secret (32+ characters). Development secrets and filesystem
# storage are forbidden in production.
