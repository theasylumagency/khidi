{
  "name": "khidi-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm check:boundaries && corepack pnpm -r lint",
    "check:boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "node --import ./scripts/test-environment.mjs ./node_modules/vitest/vitest.mjs run",
    "test:safety": "node --import ./scripts/test-environment.mjs ./node_modules/vitest/vitest.mjs run --config vitest.safety.config.ts",
    "db:migrate": "corepack pnpm --filter @khidi/db migrate",
    "db:seed": "corepack pnpm --filter @khidi/db seed && corepack pnpm --filter @khidi/products seed",
    "dev:hub": "corepack pnpm --filter @khidi/hub dev",
    "dev:worker": "corepack pnpm --filter @khidi/worker dev",
    "media:jobs:deploy": "node --env-file-if-exists=.env --import tsx ops/media-jobs-deploy.ts",
    "media:dev:init": "node --env-file-if-exists=.env --import tsx ops/minio-dev-init.ts",
    "media:storage": "node --env-file-if-exists=.env --import tsx ops/media-storage.ts",
    "media:restore": "node --env-file-if-exists=.env --import tsx ops/media-restore.ts"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "dependency-cruiser": "16.10.2",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
