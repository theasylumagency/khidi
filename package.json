{
  "name": "khidi-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "ops:reference-data": "node --env-file-if-exists=.env --import tsx ops/reference-data.ts",
    "reports:daily": "node --env-file-if-exists=.env --import tsx ops/reports-daily.ts",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "corepack pnpm check:boundaries && corepack pnpm -r lint",
    "check:boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "node --import ./scripts/test-environment.mjs ./node_modules/vitest/vitest.mjs run",
    "test:safety": "node --import ./scripts/test-environment.mjs ./node_modules/vitest/vitest.mjs run --config vitest.safety.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/db/src/seed.ts && node --env-file-if-exists=.env --import tsx packages/products/src/seed-products.ts",
    "dev:hub": "corepack pnpm --filter @khidi/hub dev",
    "dev:worker": "corepack pnpm --filter @khidi/worker dev",
    "media:jobs:deploy": "node --env-file-if-exists=.env --import tsx ops/media-jobs-deploy.ts",
    "media:dev:init": "node --env-file-if-exists=.env --import tsx ops/minio-dev-init.ts",
    "media:storage": "node --env-file-if-exists=.env --import tsx ops/media-storage.ts",
    "media:restore": "node --env-file-if-exists=.env --import tsx ops/media-restore.ts",
    "ops:bootstrap-admin": "node --env-file-if-exists=.env --import tsx ops/bootstrap-admin.ts",
    "ops:recover-user": "node --env-file-if-exists=.env --import tsx ops/recover-user.ts",
    "ops:check-config": "node --env-file-if-exists=.env --import tsx ops/check-production-config.ts",
    "inventory:verify": "node --env-file-if-exists=.env --import tsx ops/inventory-verify.ts",
    "api:openapi": "node --import tsx ops/storefront-openapi.ts",
    "api:test-client": "node --import tsx ops/storefront-local-smoke.ts",
    "ops:e2e": "node --import tsx ops/m11-e2e.ts",
    "ops:restore-drill": "node --import tsx ops/restore-drill.ts"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "dependency-cruiser": "16.10.2",
    "fast-check": "4.3.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
