# Template only. Supply secrets through protected service configuration; never commit a filled file.
NODE_ENV=production
DATABASE_URL=
# Deployment/operations only: same host, port and database, role hub_migrator.
# Omit from app and worker environments. Runtime DATABASE_URL must use hub_app.
DATABASE_MIGRATOR_URL=
HUB_TOTP_ENCRYPTION_KEY=
MEDIA_SIGNING_SECRET=
KHIDI_PROXY_TOKEN=
WEBAUTHN_RP_ID=app.khidi.app
WEBAUTHN_ORIGIN=https://app.khidi.app
AUTH_RECENT_WINDOW_SECONDS=600
KHIDI_API_HOST=api.khidi.app
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://app.khidi.app
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_PRIVATE_BUCKET=
MEDIA_PUBLIC_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Non-secret declarations checked at runtime. Verify actual backup/archive/protection separately.
BACKUP_REPOSITORY_URL=
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=aes-256-cbc
PG_WAL_ARCHIVING=on
BACKUP_SCHEDULE="0 2 * * *"
# Operations only; this protected file contains pgBackRest/IAM/cipher settings.
PGBACKREST_CONFIG=/etc/pgbackrest/pgbackrest.conf
# AI remains synthetic/disabled; no live provider is introduced by M11.
AI_PROVIDER=disabled
