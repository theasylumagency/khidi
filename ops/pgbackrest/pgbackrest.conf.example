# Provision neutral names and the actual region before enabling the service.
# Credentials use the host's IAM role. Supply the cipher password through the
# service environment / secret manager, never commit it or put it on the CLI.
[global]
repo1-type=s3
repo1-path=/khidi/pgbackrest
repo1-s3-bucket=SET_NEUTRAL_BUCKET
repo1-s3-endpoint=SET_S3_ENDPOINT
repo1-s3-region=SET_REGION
repo1-s3-key-type=auto
repo1-cipher-type=aes-256-cbc
repo1-retention-full-type=time
repo1-retention-full=30
start-fast=y
log-level-console=info
log-level-file=off
lock-path=/var/run/pgbackrest

[khidi]
pg1-path=/var/lib/postgresql/18/khidi
pg1-port=5432
pg1-socket-path=/var/run/postgresql
pg1-user=hub_migrator
pg1-database=agrotrade_hub
